# copy this to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT signing secret — generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# MongoDB connection string
# Local:        mongodb://localhost:27017
# Atlas:        mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB_NAME=vishwakarma

# Local file storage root (session folders created under DATA_DIR/sessions/)
DATA_DIR=./data
